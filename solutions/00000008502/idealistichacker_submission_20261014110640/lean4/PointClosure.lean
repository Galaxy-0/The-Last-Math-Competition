import Mathlib.RingTheory.Nullstellensatz
import Mathlib.RingTheory.Spectrum.Prime.Topology
import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.RingTheory.KrullDimension.Field
import Mathlib.Data.Complex.Basic
import Mathlib.LinearAlgebra.Matrix.Determinant.Basic

noncomputable section

namespace PointClosure8502

open MvPolynomial

variable {s : Type*} {k : Type*} [Field k]

/-- The ideal generated by the actual coordinate equalities at a point. -/
def coordinateIdeal (a : s → k) : Ideal (MvPolynomial s k) :=
  Ideal.span (Set.range fun i => X i - C (a i))

theorem coordinateIdeal_le_vanishingIdeal (a : s → k) :
    coordinateIdeal a ≤ vanishingIdeal k {a} := by
  rw [coordinateIdeal, Ideal.span_le]
  rintro p ⟨i, rfl⟩
  simp

theorem zeroLocus_coordinateIdeal (a : s → k) :
    zeroLocus k (coordinateIdeal a) = {a} := by
  ext b
  constructor
  · intro hb
    apply Set.mem_singleton_iff.mpr
    funext i
    have hi := hb (X i - C (a i))
      (Ideal.subset_span (Set.mem_range_self i))
    simpa using sub_eq_zero.mp (by simpa using hi : b i - a i = 0)
  · intro hb
    have hba : b = a := Set.mem_singleton_iff.mp hb
    subst b
    exact zeroLocus_anti_mono (coordinateIdeal_le_vanishingIdeal a)
      (zeroLocus_vanishingIdeal_le {a} (Set.mem_singleton a))

theorem zeroLocus_vanishingIdeal_singleton (a : s → k) :
    zeroLocus k (vanishingIdeal k {a}) = {a} := by
  apply le_antisymm
  · intro b hb
    have h := zeroLocus_anti_mono (coordinateIdeal_le_vanishingIdeal a) hb
    rwa [zeroLocus_coordinateIdeal a] at h
  · exact zeroLocus_vanishingIdeal_le {a}

/-- Standard affine algebraic closure: common zeros of all polynomials vanishing on S. -/
def algebraicClosure (S : Set (s → k)) : Set (s → k) :=
  zeroLocus k (vanishingIdeal k S)

theorem subset_algebraicClosure (S : Set (s → k)) : S ⊆ algebraicClosure S :=
  zeroLocus_vanishingIdeal_le S

/-- This is the least algebraic zero locus containing S, not an arbitrary closure label. -/
theorem algebraicClosure_le_zeroLocus_iff (S : Set (s → k))
    (J : Ideal (MvPolynomial s k)) :
    algebraicClosure S ⊆ zeroLocus k J ↔ S ⊆ zeroLocus k J := by
  constructor
  · exact fun h => (subset_algebraicClosure S).trans h
  · intro h
    exact zeroLocus_anti_mono (le_zeroLocus_iff_le_vanishingIdeal.mp h)

theorem algebraicClosure_zeroLocus (J : Ideal (MvPolynomial s k)) :
    algebraicClosure (zeroLocus k J) = zeroLocus k J := by
  apply le_antisymm
  · exact (algebraicClosure_le_zeroLocus_iff _ J).mpr (fun _ h => h)
  · exact subset_algebraicClosure _

theorem algebraicClosure_idempotent (S : Set (s → k)) :
    algebraicClosure (algebraicClosure S) = algebraicClosure S :=
  algebraicClosure_zeroLocus _

theorem algebraicClosure_singleton (a : s → k) :
    algebraicClosure {a} = {a} := zeroLocus_vanishingIdeal_singleton a

/-- The standard Zariski topology on coordinate points, pulled back from the prime spectrum. -/
abbrev zariskiTopology : TopologicalSpace (s → k) :=
  TopologicalSpace.induced (pointToPoint (k := k) (K := k)) inferInstance

theorem pointToPoint_preimage_zeroLocus (J : Ideal (MvPolynomial s k)) :
    pointToPoint (k := k) ⁻¹' PrimeSpectrum.zeroLocus (J : Set (MvPolynomial s k)) =
      zeroLocus k J := by
  ext a
  change (J ≤ vanishingIdeal k {a}) ↔ ∀ p ∈ J, aeval a p = 0
  simp only [SetLike.le_def, mem_vanishingIdeal_singleton_iff]

theorem zariski_isClosed_zeroLocus (J : Ideal (MvPolynomial s k)) :
    @IsClosed (s → k) zariskiTopology (zeroLocus k J) := by
  apply isClosed_induced_iff.mpr
  exact ⟨PrimeSpectrum.zeroLocus (J : Set (MvPolynomial s k)),
    PrimeSpectrum.isClosed_zeroLocus _, pointToPoint_preimage_zeroLocus J⟩

theorem zariski_isClosed_iff (S : Set (s → k)) :
    @IsClosed (s → k) zariskiTopology S ↔
      ∃ J : Ideal (MvPolynomial s k), S = zeroLocus k J := by
  constructor
  · intro h
    obtain ⟨Z, hZ, hS⟩ := isClosed_induced_iff.mp h
    obtain ⟨J, rfl⟩ := (PrimeSpectrum.isClosed_iff_zeroLocus_ideal Z).mp hZ
    exact ⟨J, hS.symm.trans (pointToPoint_preimage_zeroLocus J)⟩
  · rintro ⟨J, rfl⟩
    exact zariski_isClosed_zeroLocus J

def zariskiClosure (S : Set (s → k)) : Set (s → k) :=
  @closure (s → k) zariskiTopology S

/-- The topological closure agrees with the zero locus of the actual vanishing ideal. -/
theorem zariskiClosure_eq_algebraicClosure (S : Set (s → k)) :
    zariskiClosure S = algebraicClosure S := by
  let : TopologicalSpace (s → k) := zariskiTopology
  change closure S = algebraicClosure S
  apply le_antisymm
  · exact closure_minimal (subset_algebraicClosure S) (zariski_isClosed_zeroLocus _)
  · obtain ⟨J, hJ⟩ := (zariski_isClosed_iff (closure S)).mp isClosed_closure
    rw [hJ]
    exact (algebraicClosure_le_zeroLocus_iff S J).mpr (hJ ▸ subset_closure)

theorem zariskiClosure_singleton (a : s → k) : zariskiClosure {a} = {a} := by
  rw [zariskiClosure_eq_algebraicClosure, algebraicClosure_singleton]

theorem vanishingIdeal_singleton_eq_kernel (a : s → k) :
    vanishingIdeal k {a} = RingHom.ker (aeval (R := k) a) := by
  ext p
  exact mem_vanishingIdeal_singleton_iff a p

theorem evaluation_surjective (a : s → k) :
    Function.Surjective (aeval (R := k) a) := by
  intro c
  exact ⟨C c, by simp⟩

/-- The coordinate ring is a genuine polynomial quotient by the point's vanishing ideal. -/
abbrev CoordinateRing (S : Set (s → k)) :=
  MvPolynomial s k ⧸ vanishingIdeal k S

def pointCoordinateRingEquiv (a : s → k) : CoordinateRing {a} ≃ₐ[k] k :=
  (Ideal.quotientEquivAlgOfEq k (vanishingIdeal_singleton_eq_kernel a)).trans
    (Ideal.quotientKerAlgEquivOfSurjective (evaluation_surjective a))

theorem pointCoordinateRingEquiv_mk (a : s → k) (p : MvPolynomial s k) :
    pointCoordinateRingEquiv a (Ideal.Quotient.mk _ p) = aeval a p := by
  simp [pointCoordinateRingEquiv]

theorem pointCoordinateRing_krullDim (a : s → k) :
    ringKrullDim (CoordinateRing {a}) = 0 := by
  rw [ringKrullDim_eq_of_ringEquiv (pointCoordinateRingEquiv a).toRingEquiv]
  exact ringKrullDim_eq_zero_of_field k

theorem closurePointCoordinateRing_krullDim (a : s → k) :
    ringKrullDim (CoordinateRing (algebraicClosure {a})) = 0 := by
  rw [algebraicClosure_singleton]
  exact pointCoordinateRing_krullDim a

abbrev Matrix2 := Matrix (Fin 2) (Fin 2) ℂ
abbrev MatrixPoint := Fin 5 → ℂ

def matrixCoords (M : Matrix2) : MatrixPoint :=
  ![M 0 0, M 0 1, M 1 0, M 1 1, (Matrix.det M)⁻¹]

def identityPoint : MatrixPoint := ![1, 0, 0, 1, 1]

theorem identity_matrixCoords : matrixCoords (1 : Matrix2) = identityPoint := by
  simp [matrixCoords, identityPoint]

def matrixOfPoint (p : MatrixPoint) : Matrix2 := !![p 0, p 1; p 2, p 3]

theorem matrixOfPoint_identity : matrixOfPoint identityPoint = 1 := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [matrixOfPoint, identityPoint]

theorem matrixOfPoint_matrixCoords (M : Matrix2) : matrixOfPoint (matrixCoords M) = M := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [matrixOfPoint, matrixCoords]

theorem matrixCoords_injective : Function.Injective matrixCoords := by
  intro M N h
  have h' := congrArg matrixOfPoint h
  simpa only [matrixOfPoint_matrixCoords] using h'

def determinantRelation : MvPolynomial (Fin 5) ℂ :=
  X 4 * (X 0 * X 3 - X 1 * X 2) - 1

theorem determinantRelation_eval_identity : aeval identityPoint determinantRelation = 0 := by
  simp [determinantRelation, identityPoint]

theorem determinantRelation_mem_pointIdeal :
    determinantRelation ∈ vanishingIdeal ℂ {identityPoint} := by
  exact (mem_vanishingIdeal_singleton_iff _ _).mpr determinantRelation_eval_identity

theorem determinantRelation_eval_matrixCoords (M : Matrix2) (hM : Matrix.det M ≠ 0) :
    aeval (matrixCoords M) determinantRelation = 0 := by
  simp only [determinantRelation, map_sub, map_mul, map_one, aeval_X]
  change (Matrix.det M)⁻¹ * (M 0 0 * M 1 1 - M 0 1 * M 1 0) - 1 = 0
  rw [← Matrix.det_fin_two, inv_mul_cancel₀ hM, sub_self]

theorem identity_zeroLocus_coordinateIdeal :
    zeroLocus ℂ (coordinateIdeal identityPoint) = {identityPoint} :=
  zeroLocus_coordinateIdeal identityPoint

theorem identity_algebraicClosure : algebraicClosure {identityPoint} = {identityPoint} :=
  algebraicClosure_singleton identityPoint

theorem identity_matrix_closure :
    algebraicClosure (matrixCoords '' ({1} : Set Matrix2)) = {identityPoint} := by
  rw [Set.image_singleton, identity_matrixCoords]
  exact identity_algebraicClosure

def identityCoordinateRingEquiv : CoordinateRing {identityPoint} ≃ₐ[ℂ] ℂ :=
  pointCoordinateRingEquiv identityPoint

theorem identity_coordinateRing_krullDim : ringKrullDim (CoordinateRing {identityPoint}) = 0 :=
  pointCoordinateRing_krullDim identityPoint

theorem identity_matrix_closure_krullDim :
    ringKrullDim (CoordinateRing (algebraicClosure (matrixCoords '' ({1} : Set Matrix2)))) = 0 := by
  rw [identity_matrix_closure]
  exact identity_coordinateRing_krullDim

theorem identity_matrix_zariskiClosure :
    zariskiClosure (matrixCoords '' ({1} : Set Matrix2)) = {identityPoint} := by
  rw [zariskiClosure_eq_algebraicClosure, identity_matrix_closure]

theorem identity_matrix_zariskiClosure_krullDim :
    ringKrullDim (CoordinateRing (zariskiClosure (matrixCoords '' ({1} : Set Matrix2)))) = 0 := by
  rw [identity_matrix_zariskiClosure]
  exact identity_coordinateRing_krullDim


/-- Actual invertible complex matrices, with the usual determinant-nonzero condition. -/
abbrev InvertibleMatrices := {M : Matrix2 // Matrix.det M ≠ 0}

def glPointCoords (M : InvertibleMatrices) : MatrixPoint := matrixCoords M.val

abbrev glZariskiTopology : TopologicalSpace InvertibleMatrices :=
  TopologicalSpace.induced glPointCoords (zariskiTopology (s := Fin 5) (k := ℂ))

def identityInvertibleMatrix : InvertibleMatrices := ⟨1, by simp⟩

theorem glPointCoords_identity : glPointCoords identityInvertibleMatrix = identityPoint :=
  identity_matrixCoords

theorem glPointCoords_injective : Function.Injective glPointCoords := by
  intro M N h
  exact Subtype.ext (matrixCoords_injective h)

theorem glPointCoords_satisfies_relation (M : InvertibleMatrices) :
    aeval (glPointCoords M) determinantRelation = 0 :=
  determinantRelation_eval_matrixCoords M.val M.property


theorem matrixCoords_matrixOfPoint_of_relation (p : MatrixPoint)
    (hp : aeval p determinantRelation = 0) : matrixCoords (matrixOfPoint p) = p := by
  have hm : p 4 * Matrix.det (matrixOfPoint p) = 1 := by
    apply sub_eq_zero.mp
    simpa [determinantRelation, matrixOfPoint, Matrix.det_fin_two] using hp
  have hz : (Matrix.det (matrixOfPoint p))⁻¹ = p 4 :=
    inv_eq_of_mul_eq_one_left hm
  funext i
  fin_cases i
  · simp [matrixCoords, matrixOfPoint]
  · simp [matrixCoords, matrixOfPoint]
  · simp [matrixCoords, matrixOfPoint]
  · simp [matrixCoords, matrixOfPoint]
  · exact hz

theorem matrixOfPoint_det_ne_zero_of_relation (p : MatrixPoint)
    (hp : aeval p determinantRelation = 0) : Matrix.det (matrixOfPoint p) ≠ 0 := by
  have hm : p 4 * Matrix.det (matrixOfPoint p) = 1 := by
    apply sub_eq_zero.mp
    simpa [determinantRelation, matrixOfPoint, Matrix.det_fin_two] using hp
  intro hzero
  rw [hzero, mul_zero] at hm
  exact zero_ne_one hm

theorem glPointCoords_range :
    Set.range glPointCoords = zeroLocus ℂ (Ideal.span {determinantRelation}) := by
  rw [zeroLocus_span]
  ext p
  constructor
  · rintro ⟨M, rfl⟩ q hq
    have hq' : q = determinantRelation := Set.mem_singleton_iff.mp hq
    rw [hq']
    exact glPointCoords_satisfies_relation M
  · intro hp
    have hr := hp determinantRelation (Set.mem_singleton determinantRelation)
    exact ⟨⟨matrixOfPoint p, matrixOfPoint_det_ne_zero_of_relation p hr⟩,
      matrixCoords_matrixOfPoint_of_relation p hr⟩


theorem glPointCoords_preimage_identity :
    glPointCoords ⁻¹' {identityPoint} = {identityInvertibleMatrix} := by
  ext M
  simp only [Set.mem_preimage, Set.mem_singleton_iff]
  constructor
  · intro h
    exact glPointCoords_injective (h.trans glPointCoords_identity.symm)
  · intro h
    rw [h, glPointCoords_identity]

theorem identity_GL_isClosed :
    @IsClosed InvertibleMatrices glZariskiTopology {identityInvertibleMatrix} := by
  let : TopologicalSpace MatrixPoint := zariskiTopology
  apply isClosed_induced_iff.mpr
  refine ⟨{identityPoint}, ?_, glPointCoords_preimage_identity⟩
  rw [← zeroLocus_coordinateIdeal identityPoint]
  exact zariski_isClosed_zeroLocus _

def glZariskiClosure (S : Set InvertibleMatrices) : Set InvertibleMatrices :=
  @closure InvertibleMatrices glZariskiTopology S

theorem identity_GL_zariskiClosure :
    glZariskiClosure {identityInvertibleMatrix} = {identityInvertibleMatrix} := by
  let : TopologicalSpace InvertibleMatrices := glZariskiTopology
  exact identity_GL_isClosed.closure_eq

theorem identity_GL_closure_coordinateRing_krullDim :
    ringKrullDim (CoordinateRing (glPointCoords '' glZariskiClosure {identityInvertibleMatrix})) =
      0 := by
  rw [identity_GL_zariskiClosure, Set.image_singleton, glPointCoords_identity]
  exact identity_coordinateRing_krullDim

end PointClosure8502
