structure Conjecture407.LRTableau (lam mu nu : YoungDiagram) : Type
number of parameters: 3
fields:
  Conjecture407.LRTableau.entry : Conjecture407.SkewCell lam nu → ℕ
  Conjecture407.LRTableau.contained : lam ≤ nu
  Conjecture407.LRTableau.rowWeak : ∀ (a b : Conjecture407.SkewCell lam nu),
      (↑a).1 = (↑b).1 → (↑a).2 ≤ (↑b).2 → self.entry a ≤ self.entry b
  Conjecture407.LRTableau.colStrict : ∀ (a b : Conjecture407.SkewCell lam nu),
      (↑a).2 = (↑b).2 → (↑a).1 < (↑b).1 → self.entry a < self.entry b
  Conjecture407.LRTableau.content : ∀ (i : ℕ), Conjecture407.entryCount self.entry i = mu.rowLen i
  Conjecture407.LRTableau.lattice : ∀ (b : Conjecture407.SkewCell lam nu) (i : ℕ),
      Conjecture407.prefixCount self.entry b (i + 1) ≤ Conjecture407.prefixCount self.entry b i
constructor:
  Conjecture407.LRTableau.mk {lam mu nu : YoungDiagram} (entry : Conjecture407.SkewCell lam nu → ℕ)
    (contained : lam ≤ nu)
    (rowWeak : ∀ (a b : Conjecture407.SkewCell lam nu), (↑a).1 = (↑b).1 → (↑a).2 ≤ (↑b).2 → entry a ≤ entry b)
    (colStrict : ∀ (a b : Conjecture407.SkewCell lam nu), (↑a).2 = (↑b).2 → (↑a).1 < (↑b).1 → entry a < entry b)
    (content : ∀ (i : ℕ), Conjecture407.entryCount entry i = mu.rowLen i)
    (lattice :
      ∀ (b : Conjecture407.SkewCell lam nu) (i : ℕ),
        Conjecture407.prefixCount entry b (i + 1) ≤ Conjecture407.prefixCount entry b i) :
    Conjecture407.LRTableau lam mu nu
