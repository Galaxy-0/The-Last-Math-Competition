  | 0, 0, 0 => ((4 : Fin 5), (0 : Fin 5))
  | 0, 0, 1 => ((4 : Fin 5), (1 : Fin 5))
  | 0, 0, 2 => ((1 : Fin 5), (4 : Fin 5))
  | 0, 0, 3 => ((1 : Fin 5), (4 : Fin 5))
