@[reducible] def Conjecture525.Plane.{u_1} : (K : Type u_1) → [inst : Field K] → Type (max 0 u_1) :=
fun K [Field K] => MvPolynomial (Fin 2) K
def Conjecture525.x.{u_1} : (K : Type u_1) → [inst : Field K] → Conjecture525.Plane K :=
fun K [Field K] => MvPolynomial.X 0
def Conjecture525.y.{u_1} : (K : Type u_1) → [inst : Field K] → Conjecture525.Plane K :=
fun K [Field K] => MvPolynomial.X 1
def Conjecture525.cusp.{u_1} : (K : Type u_1) → [inst : Field K] → Conjecture525.Plane K :=
fun K [Field K] => Conjecture525.x K ^ 2 + Conjecture525.y K ^ 3
def Conjecture525.originPower.{u_1} : (K : Type u_1) → [inst : Field K] → ℕ → Ideal (Conjecture525.Plane K) :=
fun K [Field K] q => Ideal.span {Conjecture525.x K ^ q, Conjecture525.y K ^ q}
def Conjecture525.fpt.{u_1} : (K : Type u_1) → [inst : Field K] → ℕ → Conjecture525.Plane K → ℝ :=
fun K [Field K] p f => sSup {t | ∃ e n, f ^ n ∉ Conjecture525.originPower K (p ^ e) ∧ t = ↑n / ↑p ^ e}
def Conjecture525.bracketPower.{u_1} : (K : Type u_1) →
  [inst : Field K] → Ideal (Conjecture525.Plane K) → ℕ → Ideal (Conjecture525.Plane K) :=
fun K [Field K] I q => Ideal.span ((fun g => g ^ q) '' ↑I)
def Conjecture525.thresholdAt.{u_1} : (K : Type u_1) →
  [inst : Field K] → ℕ → Conjecture525.Plane K → Ideal (Conjecture525.Plane K) → ℝ :=
fun K [Field K] p f I => sSup {t | ∃ e n, f ^ n ∉ Conjecture525.bracketPower K I (p ^ e) ∧ t = ↑n / ↑p ^ e}
def Conjecture525.globalFpt.{u_1} : (K : Type u_1) → [inst : Field K] → ℕ → Conjecture525.Plane K → ℝ :=
fun K [Field K] p f => sInf {t | ∃ I, I.IsMaximal ∧ f ∈ I ∧ t = Conjecture525.thresholdAt K p f I}
def Conjecture525.originIdeal.{u_1} : (K : Type u_1) → [inst : Field K] → Ideal (Conjecture525.Plane K) :=
fun K [Field K] => RingHom.ker MvPolynomial.constantCoeff
@[reducible] def Conjecture525.PrimeCharacteristic : Type :=
{ p // Nat.Prime p }
def Conjecture525.localPrimeThreshold : Conjecture525.PrimeCharacteristic → ℝ :=
fun p => Conjecture525.fpt (ZMod ↑p) (↑p) (Conjecture525.cusp (ZMod ↑p))
def Conjecture525.globalPrimeThreshold : Conjecture525.PrimeCharacteristic → ℝ :=
fun p => Conjecture525.globalFpt (ZMod ↑p) (↑p) (Conjecture525.cusp (ZMod ↑p))
def Conjecture525.ResidueClaim : (Conjecture525.PrimeCharacteristic → ℝ) → Prop :=
fun T => ∀ (p : Conjecture525.PrimeCharacteristic), ↑p % 3 = 2 → T p = 5 / 6
def Conjecture525.ConjectureAt : (Conjecture525.PrimeCharacteristic → ℝ) → ℝ → Prop :=
fun T L => Filter.Tendsto T (Filter.comap Subtype.val Filter.atTop) (nhds L) ∧ Conjecture525.ResidueClaim T
