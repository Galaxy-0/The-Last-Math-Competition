/-!
# Conjecture 00000001141 is false: the centre of `u(sl₂)` has Krull dimension `0`, not `1`

The conjecture (first clause): for the restricted enveloping algebra `u(g)` of a restricted Lie
algebra `g`, the Krull dimension of the centre of `u(sl_n)` is `n − 1`.  For `n = 2` this says
`Krull dim Z(u(sl₂)) = 1`.  We refute it in characteristic `p = 3`, with everything built from
scratch in core Lean 4 (no Mathlib):

* `F3`: the prime field `𝔽₃`.
* `V = 𝔽₃^27`: a 27-dimensional vector space with basis `bv i`, `i = 9a + 3b + c`
  (`bv (9a+3b+c)` plays the role of the PBW monomial `e^a h^b f^c`, `0 ≤ a,b,c < 3`).
* `opE, opH, opF : V → V`: three explicit linear operators (left multiplication by `e, h, f` in the
  PBW basis; sparse tables).
* `Gen`: the subalgebra `A ⊆ End(V)` generated by `opE, opH, opF` (closure of the identity and the
  generators under `+`, `−` and composition).  This is our model of `u(sl₂)`:
  - `rel_*`: the generators satisfy the defining relations of `u(sl₂)`:
    `[h,e] = 2e`, `[h,f] = −2f`, `[e,f] = h`, `e³ = 0`, `f³ = 0`, `h³ = h`
    (`e^[p] = 0`, `f^[p] = 0`, `h^[p] = h` is the `p`-map of `sl₂`);
  - `ev_bijective`: evaluation at the vector `1 = bv 0` is a bijection `A → V`, so
    `|A| = 3^27 = p^(dim sl₂)`.  Since `u(sl₂)` is spanned by the `27` PBW monomials and surjects
    onto `A` (universal property), `A ≅ u(sl₂)` (see the report).
* `ZU`: the centre `Z(A) = {z ∈ A : z ψ = ψ z for all ψ ∈ A}`, with `ZRing : CRing ZU` its
  commutative ring structure.
* A general commutative-ring library: ideals, prime ideals, chains of primes, `HasChain`,
  `KrullDimIs d` (the supremum of lengths of chains of prime ideals is `d`), `Finite`.
* `finite_krullDim_zero`: every finite commutative ring with a prime ideal has Krull dimension
  `0` (every prime is maximal: no strict inclusion of primes).
* `krullDim_center`: `Krull dim Z(u(sl₂)) = 0`;  `conjecture_00000001141_false`: it is not `2 − 1`
  (the first clause fails for `n = 2`, so the conjunction is false).
* `clause_fails_for_finite_rings`: no finite commutative ring has Krull dimension `n − 1` for
  `n ≥ 2`; this is the mechanism for every `n` and `p` (`dim u(sl_n) = p^(n²−1) < ∞`).
* `center_not_rank_dim`: `Z(u(sl₂))` is not one-dimensional over `𝔽₃` (it contains `1` and the
  Casimir element, linearly independent), refuting also the "dimension = rank (= 1)" reading of
  the second clause for `g = sl₂`.
-/

namespace RestrictedSL2

/-! ## 1. The field `𝔽₃` -/

/-- The prime field `𝔽₃ = {z, o, t} = {0, 1, 2}`. -/
inductive F3 | z | o | t
  deriving DecidableEq, Repr

namespace F3

def add : F3 → F3 → F3
  | z, a => a
  | a, z => a
  | o, o => t
  | o, t => z
  | t, o => z
  | t, t => o

def mul : F3 → F3 → F3
  | z, _ => z
  | _, z => z
  | o, a => a
  | a, o => a
  | t, t => o

def neg : F3 → F3
  | z => z
  | o => t
  | t => o

/-- Reduction mod 3. -/
def ofN (n : Nat) : F3 :=
  match n % 3 with
  | 0 => z
  | 1 => o
  | _ => t

instance : Add F3 := ⟨add⟩
instance : Mul F3 := ⟨mul⟩
instance : Neg F3 := ⟨neg⟩
instance (n : Nat) : OfNat F3 n := ⟨ofN n⟩

theorem add_assoc (a b c : F3) : a + b + c = a + (b + c) := by
  cases a <;> cases b <;> cases c <;> decide
theorem add_comm (a b : F3) : a + b = b + a := by cases a <;> cases b <;> decide
theorem zero_add (a : F3) : 0 + a = a := by cases a <;> decide
theorem add_zero (a : F3) : a + 0 = a := by cases a <;> decide
theorem neg_add (a : F3) : -a + a = 0 := by cases a <;> decide
theorem add_neg (a : F3) : a + -a = 0 := by cases a <;> decide
theorem mul_assoc (a b c : F3) : a * b * c = a * (b * c) := by
  cases a <;> cases b <;> cases c <;> decide
theorem mul_comm (a b : F3) : a * b = b * a := by cases a <;> cases b <;> decide
theorem one_mul (a : F3) : 1 * a = a := by cases a <;> decide
theorem mul_one (a : F3) : a * 1 = a := by cases a <;> decide
theorem zero_mul (a : F3) : 0 * a = 0 := by cases a <;> decide
theorem mul_zero (a : F3) : a * 0 = 0 := by cases a <;> decide
theorem mul_add (a b c : F3) : a * (b + c) = a * b + a * c := by
  cases a <;> cases b <;> cases c <;> decide
theorem add_mul (a b c : F3) : (a + b) * c = a * c + b * c := by
  cases a <;> cases b <;> cases c <;> decide
theorem neg_add_distrib (a b : F3) : -(a + b) = -a + -b := by cases a <;> cases b <;> decide
theorem neg_eq_two_mul (a : F3) : -a = 2 * a := by cases a <;> decide
theorem two_mul (a : F3) : 2 * a = a + a := by cases a <;> decide
theorem eq_zero_of_add_self (a : F3) (h : a = a + a) : a = 0 := by
  cases a <;> first | rfl | exact absurd h (by decide)
theorem mul_eq_zero (a b : F3) (h : a * b = 0) : a = 0 ∨ b = 0 := by
  cases a <;> cases b <;> first | exact Or.inl rfl | exact Or.inr rfl | exact absurd h (by decide)
theorem one_ne_zero : (1 : F3) ≠ 0 := by decide
/-- The key step of the additivity of sparse operators. -/
theorem sp_step (c a b x y : F3) : c * (a + b) + (x + y) = (c * a + x) + (c * b + y) := by
  cases c <;> cases a <;> cases b <;> cases x <;> cases y <;> decide
theorem neg_mul (a b : F3) : -(a * b) = a * -b := by cases a <;> cases b <;> decide

end F3

/-! ## 2. The vector space `V = 𝔽₃^27` -/

abbrev V := Fin 27 → F3

/-- Coordinate `j` of `v` (and `0` for `j ≥ 27`). -/
def get (v : V) (j : Nat) : F3 := if h : j < 27 then v ⟨j, h⟩ else 0

def vadd (v w : V) : V := fun k => v k + w k
def vneg (v : V) : V := fun k => -(v k)
def vzero : V := fun _ => 0
def vsmul (c : F3) (v : V) : V := fun k => c * v k
/-- The basis vector `bv i` (for `i = 9a+3b+c` it stands for the PBW monomial `e^a h^b f^c`). -/
def bv (i : Nat) : V := fun k => if k.val = i then 1 else 0

theorem ext_get {v w : V} (h : ∀ k, k < 27 → get v k = get w k) : v = w := by
  funext ⟨k, hk⟩
  have := h k hk
  simpa [get, hk] using this

instance : DecidableEq V := fun v w =>
  decidable_of_iff (∀ k, k < 27 → get v k = get w k) ⟨ext_get, fun h _ _ => h ▸ rfl⟩

theorem get_vadd (v w : V) (j : Nat) : get (vadd v w) j = get v j + get w j := by
  unfold get; split
  · rfl
  · rfl

theorem vadd_assoc (u v w : V) : vadd (vadd u v) w = vadd u (vadd v w) := by
  funext k; exact F3.add_assoc _ _ _
theorem vadd_comm (u v : V) : vadd u v = vadd v u := by funext k; exact F3.add_comm _ _
theorem vzero_vadd (v : V) : vadd vzero v = v := by funext k; exact F3.zero_add _
theorem vadd_vzero (v : V) : vadd v vzero = v := by funext k; exact F3.add_zero _
theorem vneg_vadd (v : V) : vadd (vneg v) v = vzero := by funext k; exact F3.neg_add _
theorem vadd_vneg (v : V) : vadd v (vneg v) = vzero := by funext k; exact F3.add_neg _
theorem vneg_add (v w : V) : vneg (vadd v w) = vadd (vneg v) (vneg w) := by
  funext k; exact F3.neg_add_distrib _ _
theorem vneg_eq_smul (v : V) : vneg v = vsmul 2 v := by funext k; exact F3.neg_eq_two_mul _
theorem vsmul_zero (v : V) : vsmul 0 v = vzero := by funext k; exact F3.zero_mul _
theorem vsmul_one (v : V) : vsmul 1 v = v := by funext k; exact F3.one_mul _
theorem vsmul_two (v : V) : vsmul 2 v = vadd v v := by funext k; exact F3.two_mul _

/-- Finite sums `Σ_{i<n} g i`. -/
def vsum : Nat → (Nat → V) → V
  | 0, _ => vzero
  | n + 1, g => vadd (vsum n g) (g n)

theorem vsum_congr {g g' : Nat → V} : ∀ n, (∀ i, i < n → g i = g' i) → vsum n g = vsum n g'
  | 0, _ => rfl
  | n + 1, h => by
    simp only [vsum]
    rw [vsum_congr n (fun i hi => h i (by omega)), h n (by omega)]

theorem vsum_basis_apply (v : V) (k : Fin 27) :
    ∀ n, vsum n (fun i => vsmul (get v i) (bv i)) k = if k.val < n then v k else 0
  | 0 => by simp [vsum, vzero]
  | n + 1 => by
    simp only [vsum]
    show vsum n (fun i => vsmul (get v i) (bv i)) k + get v n * bv n k = _
    rw [vsum_basis_apply v k n]
    by_cases h1 : k.val < n
    · have h2 : ¬ k.val = n := by omega
      simp [bv, h1, h2, Nat.lt_succ_of_lt h1, F3.mul_zero, F3.add_zero]
    · by_cases h2 : k.val = n
      · have hn : n < 27 := h2 ▸ k.isLt
        have hk : (⟨n, hn⟩ : Fin 27) = k := Fin.ext h2.symm
        simp [bv, h1, h2, get, hn, hk, F3.mul_one, F3.zero_add]
      · have h3 : ¬ k.val < n + 1 := by omega
        simp [bv, h1, h2, h3, F3.mul_zero, F3.add_zero]

/-- Every vector is the sum of its coordinates times the basis vectors. -/
theorem decomp (v : V) : v = vsum 27 (fun i => vsmul (get v i) (bv i)) := by
  funext k
  rw [vsum_basis_apply v k 27]
  simp [k.isLt]

/-! ## 3. Additive maps -/

def Additive (φ : V → V) : Prop := ∀ v w, φ (vadd v w) = vadd (φ v) (φ w)

theorem Additive.map_zero {φ : V → V} (h : Additive φ) : φ vzero = vzero := by
  have h0 := h vzero vzero
  rw [vzero_vadd] at h0
  funext k
  exact F3.eq_zero_of_add_self _ (congrFun h0 k)

theorem Additive.map_smul {φ : V → V} (h : Additive φ) (c : F3) (v : V) :
    φ (vsmul c v) = vsmul c (φ v) := by
  cases c
  · show φ (vsmul 0 v) = vsmul 0 (φ v)
    rw [vsmul_zero, vsmul_zero, h.map_zero]
  · show φ (vsmul 1 v) = vsmul 1 (φ v)
    rw [vsmul_one, vsmul_one]
  · show φ (vsmul 2 v) = vsmul 2 (φ v)
    rw [vsmul_two, vsmul_two, h]

theorem Additive.map_neg {φ : V → V} (h : Additive φ) (v : V) : φ (vneg v) = vneg (φ v) := by
  rw [vneg_eq_smul, vneg_eq_smul, h.map_smul]

theorem Additive.map_vsum {φ : V → V} (h : Additive φ) (g : Nat → V) :
    ∀ n, φ (vsum n g) = vsum n (fun i => φ (g i))
  | 0 => h.map_zero
  | n + 1 => by simp only [vsum]; rw [h, h.map_vsum g n]

/-- Two additive maps that agree on the basis are equal. -/
theorem ext_basis {φ ψ : V → V} (hφ : Additive φ) (hψ : Additive ψ)
    (h : ∀ i, i < 27 → φ (bv i) = ψ (bv i)) : φ = ψ := by
  funext v
  rw [decomp v, hφ.map_vsum, hψ.map_vsum]
  apply vsum_congr
  intro i hi
  rw [hφ.map_smul, hψ.map_smul, h i hi]

/-! ## 4. Sparse operators and the generators of `u(sl₂)`

`Op T` is the linear map whose `k`-th output coordinate is `Σ_{(j,c) ∈ T[k]} c · v_j`.
The tables below are the left/right multiplications by `e, h, f` on the PBW basis
`e^a h^b f^c ↔ bv (9a+3b+c)` of `u(sl₂)` over `𝔽₃` (computed by normal ordering, see the
report and `verify.py`).  Their meaning is certified by the theorems of §5 alone. -/

def sp : List (Nat × Nat) → V → F3
  | [], _ => 0
  | (j, c) :: t, v => F3.ofN c * get v j + sp t v

def Op (T : List (List (Nat × Nat))) (v : V) : V := fun k => sp (T.getD k.val []) v

theorem sp_add (v w : V) : ∀ L : List (Nat × Nat), sp L (vadd v w) = sp L v + sp L w
  | [] => rfl
  | (j, c) :: t => by
    simp only [sp]
    rw [get_vadd, sp_add v w t, F3.sp_step]

theorem Op_additive (T : List (List (Nat × Nat))) : Additive (Op T) := by
  intro v w; funext k; exact sp_add v w _

