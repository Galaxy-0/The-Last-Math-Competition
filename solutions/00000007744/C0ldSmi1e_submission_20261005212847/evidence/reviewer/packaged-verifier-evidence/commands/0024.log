def Conjecture7744.RegularGraph : (V : Type) → [inst : Fintype V] → ℕ → Type :=
fun V [Fintype V] d => { G // G.IsRegularOfDegree d }
def Conjecture7744.quadraticTrace : (V : Type) →
  [inst : Fintype V] → (d : ℕ) → ℝ → ℝ → Conjecture7744.RegularGraph V d → ℝ :=
fun V [Fintype V] d a b G => b * ((a • SimpleGraph.adjMatrix ℝ ↑G) ^ 2).trace
def Conjecture7744.uniformGraphs : (V : Type) →
  [inst : Fintype V] →
    (d : ℕ) → [inst_1 : Nonempty (Conjecture7744.RegularGraph V d)] → PMF (Conjecture7744.RegularGraph V d) :=
fun V [Fintype V] d [Nonempty (Conjecture7744.RegularGraph V d)] =>
  PMF.uniformOfFintype (Conjecture7744.RegularGraph V d)
def Conjecture7744.quadraticExpectation : (V : Type) →
  [inst : Fintype V] → (d : ℕ) → [inst : Nonempty (Conjecture7744.RegularGraph V d)] → ℝ → ℝ → ℝ :=
fun V [Fintype V] d [Nonempty (Conjecture7744.RegularGraph V d)] a b =>
  ∫ (G : Conjecture7744.RegularGraph V d),
    Conjecture7744.quadraticTrace V d a b G ∂(Conjecture7744.uniformGraphs V d).toMeasure
def Conjecture7744.quadraticFluctuation : (V : Type) →
  [inst : Fintype V] →
    (d : ℕ) → [inst_1 : Nonempty (Conjecture7744.RegularGraph V d)] → ℝ → ℝ → Conjecture7744.RegularGraph V d → ℝ :=
fun V [Fintype V] d [Nonempty (Conjecture7744.RegularGraph V d)] a b G =>
  (Conjecture7744.quadraticTrace V d a b G - Conjecture7744.quadraticExpectation V d a b) * √↑(Fintype.card V)
def Conjecture7744.quadraticLaw : (V : Type) →
  [inst : Fintype V] →
    (d : ℕ) → [inst : Nonempty (Conjecture7744.RegularGraph V d)] → ℝ → ℝ → MeasureTheory.ProbabilityMeasure ℝ :=
fun V [Fintype V] d [Nonempty (Conjecture7744.RegularGraph V d)] a b =>
  ⟨(PMF.map (Conjecture7744.quadraticFluctuation V d a b) (Conjecture7744.uniformGraphs V d)).toMeasure, ⋯⟩
def Conjecture7744.zeroLaw : MeasureTheory.ProbabilityMeasure ℝ :=
⟨MeasureTheory.Measure.dirac 0, Conjecture7744.zeroLaw._proof_3⟩
def Conjecture7744.polynomialTrace : (V : Type) →
  [inst : Fintype V] → (d : ℕ) → ℝ → ℝ → Polynomial ℝ → Conjecture7744.RegularGraph V d → ℝ :=
fun V [Fintype V] d a b p G => b * ((Polynomial.aeval (a • SimpleGraph.adjMatrix ℝ ↑G)) p).trace
def Conjecture7744.polynomialExpectation : (V : Type) →
  [inst : Fintype V] → (d : ℕ) → [inst : Nonempty (Conjecture7744.RegularGraph V d)] → ℝ → ℝ → Polynomial ℝ → ℝ :=
fun V [Fintype V] d [Nonempty (Conjecture7744.RegularGraph V d)] a b p =>
  ∫ (G : Conjecture7744.RegularGraph V d),
    Conjecture7744.polynomialTrace V d a b p G ∂(Conjecture7744.uniformGraphs V d).toMeasure
def Conjecture7744.polynomialFluctuation : (V : Type) →
  [inst : Fintype V] →
    (d : ℕ) →
      [inst_1 : Nonempty (Conjecture7744.RegularGraph V d)] →
        ℝ → ℝ → Polynomial ℝ → Conjecture7744.RegularGraph V d → ℝ :=
fun V [Fintype V] d [Nonempty (Conjecture7744.RegularGraph V d)] a b p G =>
  (Conjecture7744.polynomialTrace V d a b p G - Conjecture7744.polynomialExpectation V d a b p) * √↑(Fintype.card V)
def Conjecture7744.polynomialLaw : (V : Type) →
  [inst : Fintype V] →
    (d : ℕ) →
      [inst : Nonempty (Conjecture7744.RegularGraph V d)] → ℝ → ℝ → Polynomial ℝ → MeasureTheory.ProbabilityMeasure ℝ :=
fun V [Fintype V] d [Nonempty (Conjecture7744.RegularGraph V d)] a b p =>
  ⟨(PMF.map (Conjecture7744.polynomialFluctuation V d a b p) (Conjecture7744.uniformGraphs V d)).toMeasure, ⋯⟩
def Conjecture7744.jointFluctuation : (V : Type) →
  [inst : Fintype V] →
    (d : ℕ) →
      [inst_1 : Nonempty (Conjecture7744.RegularGraph V d)] →
        ℝ → ℝ → {m : ℕ} → (Fin m → Polynomial ℝ) → Conjecture7744.RegularGraph V d → Fin m → ℝ :=
fun V [Fintype V] d [Nonempty (Conjecture7744.RegularGraph V d)] a b {m} p G i =>
  Conjecture7744.polynomialFluctuation V d a b (p i) G
