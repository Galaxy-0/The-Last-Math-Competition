  [inst : Fintype V] →
    (d : ℕ) →
      [inst : Nonempty (Conjecture7744.RegularGraph V d)] →
        ℝ → ℝ → {m : ℕ} → (Fin m → Polynomial ℝ) → MeasureTheory.ProbabilityMeasure (Fin m → ℝ) :=
fun V [Fintype V] d [Nonempty (Conjecture7744.RegularGraph V d)] a b {m} p =>
  ⟨(PMF.map (Conjecture7744.jointFluctuation V d a b p) (Conjecture7744.uniformGraphs V d)).toMeasure, ⋯⟩
def Conjecture7744.coordinateLaw : {m : ℕ} →
  MeasureTheory.ProbabilityMeasure (Fin m → ℝ) → Fin m → MeasureTheory.ProbabilityMeasure ℝ :=
fun {m} ν i => ν.map ⋯
def Conjecture7744.BlockVertices : ℕ → ℕ → Type :=
fun d k => Fin (k + 1) × Fin (d + 1)
def Conjecture7744.blockGraph : (d k : ℕ) → SimpleGraph (Conjecture7744.BlockVertices d k) :=
fun d k => { Adj := fun v w => v.1 = w.1 ∧ v.2 ≠ w.2, symm := ⋯, loopless := ⋯ }
def Conjecture7744.lawVariance : MeasureTheory.ProbabilityMeasure ℝ → ℝ :=
fun ν => ProbabilityTheory.variance id ↑ν
def Conjecture7744.claimedVariance : ℕ → ℝ :=
fun d => 4 - 12 / ↑d + 8 / ↑d ^ 2
def Conjecture7744.RequiredSecondOrderLimit : ℕ → (ℕ → ℝ) → (ℕ → ℝ) → Prop :=
fun d a b =>
  ∃ limits,
    (∀ (m : ℕ) (p : Fin m → Polynomial ℝ),
        Filter.Tendsto (fun k => Conjecture7744.jointLaw (Conjecture7744.BlockVertices d k) d (a k) (b k) p)
          Filter.atTop (nhds (limits m p))) ∧
      Conjecture7744.lawVariance (Conjecture7744.coordinateLaw (limits 1 fun x => Polynomial.X ^ 2) 0) =
        Conjecture7744.claimedVariance d
