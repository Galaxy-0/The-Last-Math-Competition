#print axioms ncard_classesOfLength_of_unique
#print axioms ncard_classesUpToLength_of_unique
#print axioms knuth_instance
#print axioms quartic_instance
#print axioms card_pp_222
#print axioms two_letters_length_two
#print axioms one_letter
#print axioms length_one
#print axioms conjecture_false_upTo
