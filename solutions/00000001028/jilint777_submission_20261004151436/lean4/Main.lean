theorem hasKQS_seven : HasKQS 4 ∧ HasKQS 16 ∧ HasKQS 28 ∧ HasKQS 40 ∧ HasKQS 52 ∧
    HasKQS 64 ∧ HasKQS 76 :=
  ⟨⟨_, kqs_4⟩, ⟨_, kqs_16⟩, ⟨_, kqs_28⟩, ⟨_, kqs_40⟩, ⟨_, kqs_52⟩, ⟨_, kqs_64⟩, ⟨_, kqs_76⟩⟩

/-! ## Counting -/

/-- A duplicate-free list contained in `S` is no longer than `S`. -/
theorem length_le_of_nodup_subset : ∀ (E S : List Nat), E.Nodup → (∀ x ∈ E, x ∈ S) →
    E.length ≤ S.length := by
  intro E
  induction E with
  | nil => intro S _ _; simp
  | cons a E ih =>
    intro S hnd hsub
    rw [List.nodup_cons] at hnd
    have ha : a ∈ S := hsub a (List.mem_cons_self ..)
    have hE : ∀ x ∈ E, x ∈ S.erase a := by
      intro x hx
      have hxa : x ≠ a := fun e => hnd.1 (e ▸ hx)
      exact (List.mem_erase_of_ne hxa).mpr (hsub x (List.mem_cons_of_mem _ hx))
    have h1 := ih (S.erase a) hnd.2 hE
    rw [List.length_erase_of_mem ha] at h1
    have h2 := List.length_pos_of_mem ha
    simp only [List.length_cons]
    omega

/-- The 26 values `v ≡ 4 (mod 12)` below 316, apart from the seven constructed above. -/
def rest : List Nat :=
  [88, 100, 112, 124, 136, 148, 160, 172, 184, 196, 208, 220, 232, 244, 256, 268, 280, 292, 304]

theorem rest_length : rest.length = 19 := rfl

theorem admissible_split : ∀ v, v < 317 → v % 12 = 4 →
    (v = 4 ∨ v = 16 ∨ v = 28 ∨ v = 40 ∨ v = 52 ∨ v = 64 ∨ v = 76) ∨ v ∈ rest ∨ v = 316 := by
  decide +kernel

/-- Every exceptional value lies in `rest`. -/
theorem exceptional_mem_rest (v : Nat) (h : Exceptional v) : v ∈ rest := by
  obtain ⟨h12, hlt, hno⟩ := h
  obtain ⟨k4, k16, k28, k40, k52, k64, k76⟩ := hasKQS_seven
  rcases admissible_split v (by omega) h12 with
    (rfl | rfl | rfl | rfl | rfl | rfl | rfl) | hr | rfl
  all_goals first | exact absurd ‹_› hno | exact hr | omega

/-- **At most 19 exceptional values below 316.** -/
theorem exceptional_le_19 (E : List Nat) (hE : E.Nodup) (h : ∀ v ∈ E, Exceptional v) :
    E.length ≤ 19 :=
  rest_length ▸ length_le_of_nodup_subset E rest hE fun v hv => exceptional_mem_rest v (h v hv)

/-- No number `k ≥ 20` can be the exact number of exceptional values below 316. -/
theorem not_exactlyExceptional (k : Nat) (hk : 20 ≤ k) : ¬ ExactlyExceptional k := by
  rintro ⟨E, hE, hlen, hiff⟩
  have := exceptional_le_19 E hE fun v hv => (hiff v).mp hv
  omega

/-- **The clause "below `v₀ = 316` there are exactly 21 exceptional values" is false.** -/
theorem clause2_false : ¬ Clause2 := not_exactlyExceptional 21 (by decide)

/-- **Conjecture 00000001028 is false** (its second clause fails, whatever the truth of the first). -/
theorem conjecture_00000001028_false : ¬ Conjecture := fun h => clause2_false h.2

/-- Non-strict reading (`v ≤ 316`): still at most 20 exceptional values, so never 21. -/
theorem exceptionalLe_le_20 (E : List Nat) (hE : E.Nodup) (h : ∀ v ∈ E, ExceptionalLe v) :
    E.length ≤ 20 := by
  have := length_le_of_nodup_subset E (rest ++ [316]) hE fun v hv => by
    obtain ⟨h12, hle, hno⟩ := h v hv
    obtain ⟨k4, k16, k28, k40, k52, k64, k76⟩ := hasKQS_seven
    rcases admissible_split v (by omega) h12 with
      (rfl | rfl | rfl | rfl | rfl | rfl | rfl) | hr | rfl
    all_goals first | exact absurd ‹_› hno | simp [hr] | decide
  simpa using this

theorem clause2_le_false : ¬ ExactlyExceptionalLe 21 := by
  rintro ⟨E, hE, hlen, hiff⟩
  have := exceptionalLe_le_20 E hE fun v hv => (hiff v).mp hv
  omega

/-! ## Non-vacuity -/

/-- `HasKQS` is not trivially true: there is no KQS on 2 or 3 points. -/
theorem not_hasKQS_two_three (v : Nat) (h2 : 2 ≤ v) (h4 : v < 4) : ¬ HasKQS v := by
  rintro ⟨R, hB, _, hP⟩
  have h1 := hP 0 (by omega) 1 (by omega) (by decide)
  have hpos : 0 < (blocksOf R).countP (fun B => decide (0 ∈ B ∧ 1 ∈ B)) := by omega
  obtain ⟨B, hBm, -⟩ := List.countP_pos_iff.mp hpos
  obtain ⟨hl, hnd, hlt⟩ := hB B hBm
  have := length_le_of_nodup_subset B (List.range v) hnd fun x hx =>
    List.mem_range.mpr (hlt x hx)
  simp at this
  omega

/-- `Exceptional` means exactly what it should for admissible `v < 316`: no KQS exists. -/
theorem exceptional_iff (v : Nat) (h12 : v % 12 = 4) (hlt : v < 316) :
    Exceptional v ↔ ¬ HasKQS v :=
  ⟨fun h => h.2.2, fun h => ⟨h12, hlt, h⟩⟩

/-- The admissible values below `v₀ = 316` are the 26 numbers `4, 16, …, 304`. -/
theorem admissible_below_316 :
    (List.range 316).filter (fun v => v % 12 == 4) =
      [4, 16, 28, 40, 52, 64, 76] ++ rest := by decide +kernel

end KQS

