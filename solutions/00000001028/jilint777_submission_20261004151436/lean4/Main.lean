/-!
# Conjecture 00000001028: Kirkman quadruple systems below 316

The conjecture states that resolvable `S(2,4,v)` designs (Kirkman quadruple systems,
KQS) exist for all `v ≡ 4 (mod 12)` with `v ≥ v₀ = 316`, and that **below `v₀` there are
exactly 21 exceptional values**.  The second clause is false.  Only 26 values
`v ≡ 4 (mod 12)` lie below 316 (`4, 16, …, 304`), and we exhibit explicit KQS for the seven
values `4, 16, 28, 40, 52, 64, 76`.  So at most `26 − 7 = 19` values below 316 are
exceptional (at most 20 if `316` itself is counted), never 21.

Everything is defined from scratch in core Lean 4:

* `IsKQS v R`: `R` is a list of parallel classes, each a list of blocks (lists of
  points).  Every block is a 4-subset of `{0, …, v-1}`, every class contains every
  point in exactly one of its blocks, and every pair of distinct points lies in exactly
  one block.
* `HasKQS v`: some `R` satisfies `IsKQS v R`.
* `check v R : Bool` is a fast bitmask checker.  `check_sound` proves that
  `check v R = true → IsKQS v R`.  The seven designs are verified by evaluating `check` in the
  kernel (`decide +kernel`).
-/

namespace KQS

/-! ## Definitions -/

/-- A resolution: a list of parallel classes; a class is a list of blocks; a block is a
list of points (natural numbers). -/
abbrev Resolution := List (List (List Nat))

/-- All blocks of a resolution. -/
def blocksOf (R : Resolution) : List (List Nat) := R.flatten

/-- `R` is a Kirkman quadruple system (a resolvable `2-(v,4,1)` design) on the point set
`{0, …, v-1}`, with resolution `R` into parallel classes. -/
def IsKQS (v : Nat) (R : Resolution) : Prop :=
  -- every block is a set of 4 distinct points of `{0, …, v-1}`
  (∀ B ∈ blocksOf R, B.length = 4 ∧ B.Nodup ∧ ∀ x ∈ B, x < v) ∧
  -- every parallel class partitions the point set: each point lies in exactly one block of it
  (∀ C ∈ R, ∀ x, x < v → C.countP (fun B => decide (x ∈ B)) = 1) ∧
  -- every pair of distinct points lies in exactly one block (`S(2,4,v)`, `λ = 1`)
  (∀ x, x < v → ∀ y, y < v → x ≠ y →
    (blocksOf R).countP (fun B => decide (x ∈ B ∧ y ∈ B)) = 1)

/-- A Kirkman quadruple system `KQS(v)` exists. -/
def HasKQS (v : Nat) : Prop := ∃ R : Resolution, IsKQS v R

/-! ## The conjecture -/

/-- An exceptional value below `v₀ = 316`: `v ≡ 4 (mod 12)`, `v < 316`, and no KQS. -/
def Exceptional (v : Nat) : Prop := v % 12 = 4 ∧ v < 316 ∧ ¬ HasKQS v

/-- "Below `v₀` there are exactly `k` exceptional values": the exceptional values are the
entries of a duplicate-free list of length `k`. -/
def ExactlyExceptional (k : Nat) : Prop :=
  ∃ E : List Nat, E.Nodup ∧ E.length = k ∧ ∀ v, v ∈ E ↔ Exceptional v

/-- First clause: KQS exist for all `v ≡ 4 (mod 12)` with `v ≥ 316`. -/
def Clause1 : Prop := ∀ v, v % 12 = 4 → 316 ≤ v → HasKQS v

/-- Second clause: below `v₀ = 316` there are exactly 21 exceptional values. -/
def Clause2 : Prop := ExactlyExceptional 21

/-- The conjecture (both clauses). -/
def Conjecture : Prop := Clause1 ∧ Clause2

/-- Variant reading: "below `v₀`" taken non-strictly (`v ≤ 316`). -/
def ExceptionalLe (v : Nat) : Prop := v % 12 = 4 ∧ v ≤ 316 ∧ ¬ HasKQS v

def ExactlyExceptionalLe (k : Nat) : Prop :=
  ∃ E : List Nat, E.Nodup ∧ E.length = k ∧ ∀ v, v ∈ E ↔ ExceptionalLe v

/-! ## A verified bitmask checker -/

/-- The bitmask `∑_{a ∈ l} 2^a` of a list of points. -/
def mask : List Nat → Nat
  | [] => 0
  | a :: l => 2 ^ a ||| mask l

theorem testBit_mask (l : List Nat) (y : Nat) : (mask l).testBit y = decide (y ∈ l) := by
  induction l with
  | nil => simp [mask]
  | cons a l ih =>
    simp only [mask, Nat.testBit_or, Nat.testBit_two_pow, ih, List.mem_cons]
    by_cases h : y = a
    · subst h; simp
    · have h' : ¬ a = y := fun e => h e.symm
      simp [h, h']

/-- OR the masks `ms` into `acc`, failing (`none`) as soon as two of them overlap. -/
def disjUnion : List Nat → Nat → Option Nat
  | [], acc => some acc
  | m :: ms, acc => if acc &&& m == 0 then disjUnion ms (acc ||| m) else none

/-- If `disjUnion` succeeds, bit `y` of the result counts (with the bit of `acc`) how many
masks have bit `y`; in particular this number is at most one. -/
theorem disjUnion_sound : ∀ (ms : List Nat) (acc acc' : Nat), disjUnion ms acc = some acc' →
    ∀ y, ms.countP (fun m => m.testBit y) + (acc.testBit y).toNat = (acc'.testBit y).toNat := by
  intro ms
  induction ms with
  | nil =>
    intro acc acc' h y
    simp only [disjUnion, Option.some.injEq] at h
    subst h; simp
  | cons m ms ih =>
    intro acc acc' h y
    simp only [disjUnion] at h
    split at h
    · rename_i hc
      have h1 := ih _ _ h y
      have h0 : (acc &&& m).testBit y = false := by
        rw [beq_iff_eq.mp hc]; simp
      rw [Nat.testBit_and] at h0
      rw [Nat.testBit_or] at h1
      rw [List.countP_cons]
      cases ha : acc.testBit y <;> cases hm : m.testBit y <;> simp_all <;> omega
    · simp at h

/-- Bit `y` of a successful `disjUnion` from `0`: the number of masks with bit `y` is 1 iff the bit is set. -/
theorem disjUnion_count (ms : List Nat) (acc' : Nat) (h : disjUnion ms 0 = some acc') (y : Nat)
    (hy : acc'.testBit y = true) : ms.countP (fun m => m.testBit y) = 1 := by
  have := disjUnion_sound ms 0 acc' h y
  rw [hy] at this
  simpa using this

/-- A class is a partition of `{0, …, v-1}` (bitmask test). -/
def classOK (v : Nat) (C : List (List Nat)) : Bool :=
  match disjUnion (C.map mask) 0 with
  | none => false
  | some acc => (List.range v).all fun y => acc.testBit y

/-- Given the block masks `ms`: the masks of the blocks through `x`, with bit `x` cleared,
are pairwise disjoint and cover every other point of `{0, …, v-1}`. -/
def pairOK (v : Nat) (ms : List Nat) (x : Nat) : Bool :=
  match disjUnion ((ms.filter fun m => m.testBit x).map fun m => m ^^^ 2 ^ x) 0 with
  | none => false
  | some acc => (List.range v).all fun y => y == x || acc.testBit y

/-- The complete checker. -/
def check (v : Nat) (R : Resolution) : Bool :=
  (blocksOf R).all (fun (B : List Nat) => B.length == 4 && decide B.Nodup && B.all (· < v)) &&
  R.all (classOK v) &&
  (List.range v).all (pairOK v ((blocksOf R).map mask))

theorem classOK_sound (v : Nat) (C : List (List Nat)) (h : classOK v C = true) :
    ∀ x, x < v → C.countP (fun B => decide (x ∈ B)) = 1 := by
  intro x hx
  unfold classOK at h
  split at h
  · simp at h
  · rename_i acc hacc
    have hbit : acc.testBit x = true := by
      have := List.all_eq_true.mp h x (List.mem_range.mpr hx)
      simpa using this
    have := disjUnion_count _ _ hacc x hbit
    rw [List.countP_map] at this
    have hf : ((fun m => m.testBit x) ∘ mask) = (fun B => decide (x ∈ B)) := by
      funext B; simp [Function.comp, testBit_mask]
    rw [hf] at this
    exact this

theorem pairOK_sound (v : Nat) (bl : List (List Nat)) (x : Nat)
    (h : pairOK v (bl.map mask) x = true) :
    ∀ y, y < v → x ≠ y → bl.countP (fun B => decide (x ∈ B ∧ y ∈ B)) = 1 := by
  intro y hy hxy
  unfold pairOK at h
  split at h
  · simp at h
  · rename_i acc hacc
    have hbit : acc.testBit y = true := by
      have := List.all_eq_true.mp h y (List.mem_range.mpr hy)
      have hyx : (y == x) = false := by
        simp only [beq_eq_false_iff_ne, ne_eq]; exact fun e => hxy e.symm
      simpa [hyx] using this
    have := disjUnion_count _ _ hacc y hbit
    rw [List.countP_map, List.countP_filter, List.countP_map] at this
    have hf : (fun (B : List Nat) =>
          (((fun (m : Nat) => m.testBit y) ∘ fun (m : Nat) => m ^^^ 2 ^ x) (mask B) &&
            (mask B).testBit x)) = (fun (B : List Nat) => decide (x ∈ B ∧ y ∈ B)) := by
      funext B
      simp [Function.comp, testBit_mask, Nat.testBit_xor, Nat.testBit_two_pow, hxy]
      cases decide (x ∈ B) <;> simp
    rw [← hf]
    exact this

/-- **Soundness of the checker.** -/
theorem check_sound (v : Nat) (R : Resolution) (h : check v R = true) : IsKQS v R := by
  simp only [check, Bool.and_eq_true] at h
  obtain ⟨⟨h1, h2⟩, h3⟩ := h
  refine ⟨?_, ?_, ?_⟩
  · intro B hB
    have := List.all_eq_true.mp h1 B hB
    simp only [Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq, List.all_eq_true] at this
    obtain ⟨⟨hl, hn⟩, hv⟩ := this
    exact ⟨hl, hn, fun x hx => by simpa using hv x hx⟩
  · intro C hC
    exact classOK_sound v C (List.all_eq_true.mp h2 C hC)
  · intro x hx
    exact pairOK_sound v (blocksOf R) x (List.all_eq_true.mp h3 x (List.mem_range.mpr hx))

