/-!
# Conjecture 00000001022 — the "trellis lower bound" `min(k, n−k)·⌈log₂ q⌉` is false

The conjecture contains the clause

  "for any `[n,k]_q` code, the trellis complexity is at least `min(k, n−k)·⌈log₂ q⌉`".

This is Wolf's *upper* bound turned into a lower bound, and it is false.
Everything is built from scratch in Lean 4 core:

* words are `List Bool`; an `[n,k]_2` code is given by `k` linearly independent generators
  (`IsGen`), its codewords are the `2^k` combinations `span n gens`;
* a trellis (`Trellis`) is a list of layer sizes `|V_0|, …, |V_n|` and a list of sections, each a
  list of labelled edges `(from, bit, to)`; `WF` = well formed (one root, one toor, edge endpoints in
  the adjacent layers, no repeated edge); `IsPath` = a root-to-toor path with a given label sequence;
  `Represents T C` = the set of path labels of `T` is exactly `C`;
* complexity measures (`Measure.eval`): maximum number of states, maximum number of edges in a
  section, total number of vertices, total number of edges, Viterbi operation count
  `2|E| − |V| + 1`.  The clause "log₂ X ≥ B" is stated as `2^B ≤ X` (equivalent for real `log₂`);
* the minimal (BCJR / Forney) trellis profile `|C| / (|P_i|·|F_i|)` from the past and future
  subcodes `P_i`, `F_i` (`minProfile`).

Results:
* `ex10_*`: `C = {00,11}^5`, a binary `[10,5]` code, and an explicit trellis with layer sizes
  `1,2,1,2,…,1`; its path labels are exactly `C`; max states 2, max edges/section 2, 16 vertices,
  20 edges, 25 Viterbi operations, all `< 2^5 = 32`; the minimal profile is `1,2,1,2,…,1`.
* `clause_false : ∀ μ, ¬ Clause μ` and `clauseMin_false`, `clausePerm_false`, `clauseMinPerm_false`.
* `conjecture_00000001022_false : ∀ MacW μ, ¬ Conjecture MacW μ` (the MacWilliams preamble is an
  arbitrary proposition `MacW`; the conjunction fails because the trellis clause does).
* `family_*`: for every `m`, `{00,11}^m` is a `[2m, m]_2` code represented by a trellis with at most
  2 states and 2 edges per section, `3m+1` vertices, `4m` edges; so the clause fails for every
  `m ≥ 2` (states/edges) and every `m ≥ 5` (all five measures) — the gap `m` vs `1` is unbounded.
* `worstOrder_false`: even maximizing the minimal trellis over all coordinate orders, the `[4,2]`
  code generated by `1000, 0111` stays below the bound.
* non-vacuity: `rep2_clause_holds` (for `{00,11}` *every* trellis has ≥ 2 states, so the bound can
  hold for all trellises of a code) and `inter4_meets_bound` (the interleaved `[4,2]` code attains
  the bound in its minimal trellis).
-/

namespace Trellis1022

/-! ## Words and binary linear codes -/

abbrev Word := List Bool

def zeroW (n : Nat) : Word := List.replicate n false

/-- Coordinatewise sum over `F₂`. -/
def xorW : Word → Word → Word
  | a :: as, b :: bs => (a != b) :: xorW as bs
  | _, _ => []

/-- All `2^k` `F₂`-combinations of the generators (the codewords of the code they generate). -/
def span (n : Nat) : List Word → List Word
  | [] => [zeroW n]
  | g :: gs => span n gs ++ (span n gs).map (xorW g)

/-- `gens` generates a binary linear `[n,k]` code: `k` generators of length `n` that are
linearly independent (their `2^k` combinations are pairwise distinct). -/
def IsGen (n k : Nat) (gens : List Word) : Prop :=
  gens.length = k ∧ (∀ g ∈ gens, g.length = n) ∧ (span n gens).Nodup

instance (n k : Nat) (gens : List Word) : Decidable (IsGen n k gens) := by
  unfold IsGen; infer_instance

/-- `CeilLog2 q e` : `e = ⌈log₂ q⌉`, i.e. `e` is least with `q ≤ 2^e`. -/
def CeilLog2 (q e : Nat) : Prop := q ≤ 2 ^ e ∧ ∀ e', e' < e → 2 ^ e' < q

theorem ceilLog2_unique {q e e' : Nat} (h : CeilLog2 q e) (h' : CeilLog2 q e') : e = e' := by
  rcases Nat.lt_trichotomy e e' with hl | he | hl
  · have := h'.2 e hl; have := h.1; omega
  · exact he
  · have := h.2 e' hl; have := h'.1; omega

theorem ceilLog2_two : CeilLog2 2 1 := ⟨by decide, fun e' h => by
  have : e' = 0 := by omega
  subst this; decide⟩

/-! ## Trellises -/

/-- A labelled edge `(from, label, to)` between consecutive layers. -/
abbrev Edge := Nat × Bool × Nat

/-- A binary trellis of length `n`: layer sizes `|V_0|, …, |V_n|` (states of layer `i` are
`0, …, |V_i| - 1`) and sections `E_1, …, E_n`. The root and the toor are state `0`. -/
structure Trellis where
  sizes : List Nat
  secs : List (List Edge)
  deriving DecidableEq

/-- Well formed: `n+1` layers, a single root and a single toor, every edge of section `i` goes
from layer `i` to layer `i+1`, and no edge is listed twice. -/
def WF (T : Trellis) : Prop :=
  T.sizes.length = T.secs.length + 1 ∧ T.sizes.head? = some 1 ∧ T.sizes.getLast? = some 1 ∧
  (∀ i, i < T.secs.length → ∀ e ∈ T.secs.getD i [],
      e.1 < T.sizes.getD i 0 ∧ e.2.2 < T.sizes.getD (i+1) 0) ∧
  (∀ i, i < T.secs.length → (T.secs.getD i []).Nodup)

instance (T : Trellis) : Decidable (WF T) := by unfold WF; infer_instance

/-- `IsPath secs s w`: there is a path from state `s` through the sections `secs` to the toor
(state `0` of the last layer) whose edge labels spell `w`. -/
def IsPath : List (List Edge) → Nat → Word → Prop
  | [], s, [] => s = 0
  | sec :: rest, s, b :: w => ∃ t, (s, b, t) ∈ sec ∧ IsPath rest t w
  | _, _, _ => False

/-- `T` represents the code with codeword list `C`: the path labels of `T` are exactly `C`. -/
def RepresentsL (T : Trellis) (C : List Word) : Prop := ∀ w, IsPath T.secs 0 w ↔ w ∈ C

/-- `T` is a trellis for the code generated by `gens`. -/
def Represents (T : Trellis) (n : Nat) (gens : List Word) : Prop := RepresentsL T (span n gens)

/-- Path labels by explicit path enumeration. -/
def labels : List (List Edge) → Nat → List Word
  | [], s => if s = 0 then [[]] else []
  | sec :: rest, s =>
      sec.flatMap fun e => if e.1 = s then (labels rest e.2.2).map (e.2.1 :: ·) else []

theorem mem_labels : ∀ (secs : List (List Edge)) (s : Nat) (w : Word),
    w ∈ labels secs s ↔ IsPath secs s w
  | [], s, [] => by by_cases h : s = 0 <;> simp [labels, IsPath, h]
  | [], s, b :: w => by by_cases h : s = 0 <;> simp [labels, IsPath, h]
  | sec :: rest, s, [] => by
      simp only [labels, IsPath, List.mem_flatMap, iff_false]
      rintro ⟨e, -, he⟩
      split at he
      · simp at he
      · simp at he
  | sec :: rest, s, b :: w => by
      simp only [labels, IsPath, List.mem_flatMap]
      constructor
      · rintro ⟨⟨a, c, t⟩, he, hw⟩
        split at hw
        · rename_i hs
          simp only [List.mem_map, List.cons.injEq] at hw
          obtain ⟨w', hw', hc, rfl⟩ := hw
          simp only at hs hc
          subst hs; subst hc
          exact ⟨t, he, (mem_labels rest t w').1 hw'⟩
        · simp at hw
      · rintro ⟨t, he, hp⟩
        refine ⟨(s, b, t), he, ?_⟩
        simp only [if_true, List.mem_map]
        exact ⟨w, (mem_labels rest t w).2 hp, rfl⟩

/-- Decision procedure for `RepresentsL`: compare the enumerated path labels with the code. -/
theorem representsL_of_subsets {T : Trellis} {C : List Word}
    (h1 : ∀ w ∈ labels T.secs 0, w ∈ C) (h2 : ∀ w ∈ C, w ∈ labels T.secs 0) :
    RepresentsL T C := fun w =>
  ⟨fun hp => h1 w ((mem_labels _ _ _).2 hp), fun hc => (mem_labels _ _ _).1 (h2 w hc)⟩

/-! ## Complexity measures -/

def maxL : List Nat → Nat := List.foldr max 0
def sumL : List Nat → Nat := List.foldr (· + ·) 0

theorem le_maxL_getD : ∀ (l : List Nat) (i : Nat), l.getD i 0 ≤ maxL l
  | [], _ => by simp [maxL]
  | a :: l, 0 => by simp [maxL]; omega
  | a :: l, i+1 => by
      have := le_maxL_getD l i
      simp only [List.getD_cons_succ, maxL, List.foldr] at *; omega

/-- Maximum number of states `max_i |V_i|` (state complexity `s_max = log₂` of it). -/
def maxStates (T : Trellis) : Nat := maxL T.sizes
/-- Maximum number of edges in a section (edge/branch complexity `b_max = log₂` of it). -/
def maxEdges (T : Trellis) : Nat := maxL (T.secs.map List.length)
/-- Total number of vertices `|V|`. -/
def numVertices (T : Trellis) : Nat := sumL T.sizes
/-- Total number of edges `|E|`. -/
def numEdges (T : Trellis) : Nat := sumL (T.secs.map List.length)
/-- Viterbi decoding operation count `2|E| − |V| + 1` (additions plus comparisons). -/
def viterbiOps (T : Trellis) : Nat := 2 * numEdges T + 1 - numVertices T

inductive Measure where
  | states | edges | vertices | totalEdges | viterbi
  deriving DecidableEq

def Measure.eval : Measure → Trellis → Nat
  | .states, T => maxStates T
  | .edges, T => maxEdges T
  | .vertices, T => numVertices T
  | .totalEdges, T => numEdges T
  | .viterbi, T => viterbiOps T

/-! ## The clause, in every reading -/

/-- The bound `min(k, n−k)·⌈log₂ q⌉` (in bits) for a binary `[n,k]` code, with `e = ⌈log₂ 2⌉`. -/
def bound (n k e : Nat) : Nat := min k (n - k) * e

/-- **The clause** for binary codes and the complexity measure `μ` (on a log₂ scale):
for every binary `[n,k]` code `C` and every trellis `T` for `C`, `log₂ μ(T) ≥ min(k,n−k)·⌈log₂ 2⌉`.
"The trellis complexity of `C`", being the minimum of `log₂ μ` over all trellises for `C`, is
`≥ B` iff every trellis for `C` has `log₂ μ ≥ B`; and `log₂ X ≥ B ↔ 2^B ≤ X`. -/
def Clause (μ : Measure) : Prop :=
  ∀ (n k : Nat) (gens : List Word) (e : Nat), IsGen n k gens → CeilLog2 2 e →
    ∀ T : Trellis, WF T → Represents T n gens → 2 ^ bound n k e ≤ μ.eval T

/-- The conjecture: an arbitrary preamble `MacW` (the MacWilliams identities for support
weights) **and** the trellis clause. -/
def Conjecture (MacW : Prop) (μ : Measure) : Prop := MacW ∧ Clause μ

/-- Past subcode `P_i` (codewords vanishing on positions `≥ i`). -/
def pastSub (C : List Word) (i : Nat) : List Word := C.filter fun c => (c.drop i).all (· == false)
/-- Future subcode `F_i` (codewords vanishing on positions `< i`). -/
def futSub (C : List Word) (i : Nat) : List Word := C.filter fun c => (c.take i).all (· == false)

/-- Number of states of the minimal (BCJR / Forney) trellis at time `i`:
`|C / (P_i ⊕ F_i)| = |C| / (|P_i|·|F_i|)`, i.e. `s_i = k − dim P_i − dim F_i` bits. -/
def minStatesAt (C : List Word) (i : Nat) : Nat :=
  C.length / ((pastSub C i).length * (futSub C i).length)

/-- The minimal trellis state profile `|V_0|, …, |V_n|`. -/
def minProfile (n : Nat) (C : List Word) : List Nat := (List.range (n+1)).map (minStatesAt C)

/-- The clause for the minimal trellis: `s_max = max_i s_i ≥ min(k,n−k)·⌈log₂ 2⌉`. -/
def ClauseMin : Prop :=
  ∀ (n k : Nat) (gens : List Word) (e : Nat), IsGen n k gens → CeilLog2 2 e →
    2 ^ bound n k e ≤ maxL (minProfile n (span n gens))

/-- Coordinate permutation: `(permW π w)_j = w_{π j}`. -/
def permW (π : List Nat) (w : Word) : Word := π.map fun i => w.getD i false

def IsPermOf (n : Nat) (π : List Nat) : Prop := π.length = n ∧ π.Nodup ∧ ∀ i ∈ π, i < n

instance (n : Nat) (π : List Nat) : Decidable (IsPermOf n π) := by unfold IsPermOf; infer_instance

/-- The clause with trellis complexity minimized over all coordinate orders. -/
def ClausePerm (μ : Measure) : Prop :=
  ∀ (n k : Nat) (gens : List Word) (e : Nat), IsGen n k gens → CeilLog2 2 e →
    ∀ π, IsPermOf n π → ∀ T : Trellis, WF T → RepresentsL T ((span n gens).map (permW π)) →
      2 ^ bound n k e ≤ μ.eval T

/-- The minimal-trellis clause minimized over all coordinate orders. -/
def ClauseMinPerm : Prop :=
  ∀ (n k : Nat) (gens : List Word) (e : Nat), IsGen n k gens → CeilLog2 2 e →
    ∀ π, IsPermOf n π → 2 ^ bound n k e ≤ maxL (minProfile n ((span n gens).map (permW π)))

/-- The minimal-trellis clause in the *worst* coordinate order (some order reaches the bound). -/
def ClauseMinWorst : Prop :=
  ∀ (n k : Nat) (gens : List Word) (e : Nat), IsGen n k gens → CeilLog2 2 e →
    ∃ π, IsPermOf n π ∧ 2 ^ bound n k e ≤ maxL (minProfile n ((span n gens).map (permW π)))

/-! ## The counterexample: `C = {00,11}^5`, a binary `[10,5]` code -/

/-- Generators `e_{2j} + e_{2j+1}`, `j = 0, …, 4`. -/
def gens10 : List Word :=
  [ [true, true, false, false, false, false, false, false, false, false],
    [false, false, true, true, false, false, false, false, false, false],
    [false, false, false, false, true, true, false, false, false, false],
    [false, false, false, false, false, false, true, true, false, false],
    [false, false, false, false, false, false, false, false, true, true] ]

/-- At even times one state; an edge labelled `b` leads to state `b` (as a number), and at the
next step state `b` emits `b` again and returns to the single state. -/
def secA : List Edge := [(0, false, 0), (0, true, 1)]
def secB : List Edge := [(0, false, 0), (1, true, 0)]

def T10 : Trellis :=
  ⟨[1, 2, 1, 2, 1, 2, 1, 2, 1, 2, 1], [secA, secB, secA, secB, secA, secB, secA, secB, secA, secB]⟩

theorem ex10_isGen : IsGen 10 5 gens10 := by decide

theorem ex10_size : (span 10 gens10).length = 32 := by decide

theorem ex10_wf : WF T10 := by decide

theorem ex10_represents : Represents T10 10 gens10 :=
  representsL_of_subsets (by decide) (by decide)

theorem ex10_numbers :
    maxStates T10 = 2 ∧ maxEdges T10 = 2 ∧ numVertices T10 = 16 ∧ numEdges T10 = 20 ∧
    viterbiOps T10 = 25 := by decide

theorem ex10_bound : bound 10 5 1 = 5 := by decide

/-- Every measure of `T10` is below `2^5 = 32`, i.e. its `log₂` is below `5`. -/
theorem ex10_below (μ : Measure) : μ.eval T10 < 2 ^ 5 := by
  cases μ <;> decide

/-- The minimal (BCJR) trellis of `C`: `|V_i| = 1, 2, 1, 2, …, 1`, i.e. `s_i = 0,1,0,1,…,0`. -/
theorem ex10_minProfile : minProfile 10 (span 10 gens10) = [1, 2, 1, 2, 1, 2, 1, 2, 1, 2, 1] := by
  decide

theorem ex10_pastFut :
    (List.range 11).map (fun i => (pastSub (span 10 gens10) i).length) =
      [1, 1, 2, 2, 4, 4, 8, 8, 16, 16, 32] ∧
    (List.range 11).map (fun i => (futSub (span 10 gens10) i).length) =
      [32, 16, 16, 8, 8, 4, 4, 2, 2, 1, 1] := by decide

/-! ## Main theorems -/

/-- **The trellis clause is false, for every complexity measure.** -/
theorem clause_false (μ : Measure) : ¬ Clause μ := fun h => by
  have := h 10 5 gens10 1 ex10_isGen ceilLog2_two T10 ex10_wf ex10_represents
  rw [ex10_bound] at this
  exact absurd this (Nat.not_le.2 (ex10_below μ))

/-- **Main theorem.** The conjecture (any MacWilliams preamble `MacW` together with the trellis
lower bound) is false, for every complexity measure. -/
theorem conjecture_00000001022_false (MacW : Prop) (μ : Measure) : ¬ Conjecture MacW μ :=
  fun h => clause_false μ h.2

/-- The minimal-trellis reading is false as well: `s_max(C) = 1 < 5`. -/
theorem clauseMin_false : ¬ ClauseMin := fun h => by
  have := h 10 5 gens10 1 ex10_isGen ceilLog2_two
  rw [ex10_bound, ex10_minProfile] at this
  exact absurd this (by decide)

theorem conjecture_00000001022_false_min (MacW : Prop) : ¬ (MacW ∧ ClauseMin) :=
  fun h => clauseMin_false h.2

theorem id10 : IsPermOf 10 (List.range 10) := by decide

theorem perm_id10 : (span 10 gens10).map (permW (List.range 10)) = span 10 gens10 := by decide

/-- Minimizing over coordinate orders can only lower the complexity. -/
theorem clausePerm_false (μ : Measure) : ¬ ClausePerm μ := fun h => by
  have := h 10 5 gens10 1 ex10_isGen ceilLog2_two (List.range 10) id10 T10 ex10_wf
    (by rw [perm_id10]; exact ex10_represents)
  rw [ex10_bound] at this
  exact absurd this (Nat.not_le.2 (ex10_below μ))

theorem clauseMinPerm_false : ¬ ClauseMinPerm := fun h => by
  have := h 10 5 gens10 1 ex10_isGen ceilLog2_two (List.range 10) id10
  rw [ex10_bound, perm_id10, ex10_minProfile] at this
  exact absurd this (by decide)

/-! ## The smallest instance: the `[4,2]` code `{0000, 1100, 0011, 1111}` -/

def gens4 : List Word := [[true, true, false, false], [false, false, true, true]]
def T4 : Trellis := ⟨[1, 2, 1, 2, 1], [secA, secB, secA, secB]⟩

theorem ex4 : IsGen 4 2 gens4 ∧ WF T4 ∧ Represents T4 4 gens4 ∧ bound 4 2 1 = 2 ∧
    maxStates T4 = 2 ∧ maxEdges T4 = 2 ∧ 2 < 2 ^ 2 ∧
    minProfile 4 (span 4 gens4) = [1, 2, 1, 2, 1] :=
  ⟨by decide, by decide, representsL_of_subsets (by decide) (by decide), by decide, by decide,
   by decide, by decide, by decide⟩


/-! ## The whole family `{00,11}^m`, a binary `[2m, m]` code, for every `m` -/

/-- `pre a w = a a w`. -/
def pre (a : Bool) (w : Word) : Word := a :: a :: w

/-- Generators of `{00,11}^m`: `e_{2j} + e_{2j+1}`, `j < m`. -/
def repGens : Nat → List Word
  | 0 => []
  | m+1 => (true :: true :: zeroW (2*m)) :: (repGens m).map (pre false)

def repSizes : Nat → List Nat
  | 0 => [1]
  | m+1 => 1 :: 2 :: repSizes m

def repSecs : Nat → List (List Edge)
  | 0 => []
  | m+1 => secA :: secB :: repSecs m

/-- The trellis with layer sizes `1,2,1,2,…,1` (`T10 = repT 5`, `T4 = repT 2`). -/
def repT (m : Nat) : Trellis := ⟨repSizes m, repSecs m⟩

example : repT 5 = T10 ∧ repGens 5 = gens10 ∧ repT 2 = T4 ∧ repGens 2 = gens4 := by decide

theorem repGens_length : ∀ m, (repGens m).length = m
  | 0 => rfl
  | m+1 => by simp [repGens, repGens_length m]

theorem repGens_len : ∀ m, ∀ g ∈ repGens m, g.length = 2*m
  | 0 => by simp [repGens]
  | m+1 => by
      intro g hg
      simp only [repGens, List.mem_cons, List.mem_map] at hg
      rcases hg with rfl | ⟨g', hg', rfl⟩
      · simp [zeroW]; omega
      · simp [pre, repGens_len m g' hg']; omega

theorem span_length (n : Nat) : ∀ (gs : List Word), (∀ g ∈ gs, g.length = n) →
    ∀ c ∈ span n gs, c.length = n
  | [], _ => by simp [span, zeroW]
  | g :: gs, h => by
      intro c hc
      have ih := span_length n gs (fun g' hg' => h g' (List.mem_cons_of_mem _ hg'))
      simp only [span, List.mem_append, List.mem_map] at hc
      rcases hc with hc | ⟨c', hc', rfl⟩
      · exact ih c hc
      · have h1 := h g (List.mem_cons_self ..)
        have h2 := ih c' hc'
        clear ih hc' h
        induction g generalizing c' n with
        | nil => simp at h1; subst h1; cases c' <;> simp_all [xorW]
        | cons a g ihg =>
            cases c' with
            | nil => simp at h1 h2; omega
            | cons b c' =>
                simp only [List.length_cons] at h1 h2
                simp only [xorW, List.length_cons]
                rw [ihg (n-1) c' (by omega) (by omega)]; omega

theorem xorW_zero : ∀ c : Word, xorW (zeroW c.length) c = c
  | [] => rfl
  | b :: c => by
      have := xorW_zero c
      simp only [zeroW, List.length_cons, List.replicate] at *
      simp only [xorW, this]; cases b <;> rfl

theorem span_pre (n : Nat) : ∀ gs : List Word,
    span (n+2) (gs.map (pre false)) = (span n gs).map (pre false)
  | [] => rfl
  | g :: gs => by
      simp only [List.map_cons, span, span_pre n gs, List.map_append, List.map_map]
      congr 1

theorem span_rep_succ (m : Nat) :
    span (2*(m+1)) (repGens (m+1)) =
      (span (2*m) (repGens m)).map (pre false) ++ (span (2*m) (repGens m)).map (pre true) := by
  rw [show 2*(m+1) = 2*m+2 by omega]
  simp only [repGens, span, span_pre, List.map_map]
  congr 1
  apply List.map_congr_left
  intro c hc
  have hl := span_length _ _ (repGens_len m) c hc
  simp only [Function.comp, pre, xorW]
  rw [← hl, xorW_zero]; rfl

theorem mem_span_rep (m : Nat) (w : Word) :
    w ∈ span (2*(m+1)) (repGens (m+1)) ↔ ∃ a w', w = pre a w' ∧ w' ∈ span (2*m) (repGens m) := by
  rw [span_rep_succ]
  simp only [List.mem_append, List.mem_map]
  constructor
  · rintro (⟨w', h, rfl⟩ | ⟨w', h, rfl⟩)
    · exact ⟨false, w', rfl, h⟩
    · exact ⟨true, w', rfl, h⟩
  · rintro ⟨a, w', rfl, h⟩
    cases a
    · exact Or.inl ⟨w', h, rfl⟩
    · exact Or.inr ⟨w', h, rfl⟩

theorem span_rep_nodup : ∀ m, (span (2*m) (repGens m)).Nodup
  | 0 => by decide
  | m+1 => by
      rw [span_rep_succ]
      have ih := span_rep_nodup m
      unfold List.Nodup at *
      rw [List.pairwise_append, List.pairwise_map, List.pairwise_map]
      refine ⟨ih.imp fun h e => h (by simp [pre] at e; exact e),
              ih.imp fun h e => h (by simp [pre] at e; exact e), ?_⟩
      intro a ha b hb
      simp only [List.mem_map] at ha hb
      obtain ⟨_, _, rfl⟩ := ha
      obtain ⟨_, _, rfl⟩ := hb
      simp [pre]

/-- `{00,11}^m` is a binary `[2m, m]` code. -/
theorem family_isGen (m : Nat) : IsGen (2*m) m (repGens m) :=
  ⟨repGens_length m, repGens_len m, span_rep_nodup m⟩

theorem repSizes_length : ∀ m, (repSizes m).length = 2*m + 1
  | 0 => rfl
  | m+1 => by simp [repSizes, repSizes_length m]; omega

theorem repSecs_length : ∀ m, (repSecs m).length = 2*m
  | 0 => rfl
  | m+1 => by simp [repSecs, repSecs_length m]; omega

theorem repSizes_last : ∀ m (a : Nat), (a :: repSizes m).getLast? = some 1
  | 0, _ => rfl
  | m+1, a => by
      simp only [repSizes, List.getLast?_cons_cons]
      exact repSizes_last m 2

theorem repSizes_head (m : Nat) : (repSizes m).getD 0 0 = 1 := by cases m <;> rfl

theorem repSecs_sec : ∀ m i, (repSecs m).getD i [] = secA ∨ (repSecs m).getD i [] = secB ∨
    (repSecs m).getD i [] = []
  | 0, i => by simp [repSecs]
  | m+1, 0 => by simp [repSecs]
  | m+1, 1 => by simp [repSecs]
  | m+1, i+2 => by simp only [repSecs, List.getD_cons_succ]; exact repSecs_sec m i

theorem repEdges_ok : ∀ m i, i < (repSecs m).length → ∀ e ∈ (repSecs m).getD i [],
    e.1 < (repSizes m).getD i 0 ∧ e.2.2 < (repSizes m).getD (i+1) 0
  | 0, i, h => by simp [repSecs] at h
  | m+1, 0, _ => by
      intro e he
      simp only [repSecs, repSizes, List.getD_cons_zero, List.getD_cons_succ, secA,
        List.mem_cons, List.mem_nil_iff, or_false] at he ⊢
      rcases he with rfl | rfl <;> decide
  | m+1, 1, _ => by
      intro e he
      simp only [repSecs, repSizes, List.getD_cons_zero, List.getD_cons_succ, secB,
        List.mem_cons, List.mem_nil_iff, or_false, repSizes_head] at he ⊢
      rcases he with rfl | rfl <;> decide
  | m+1, i+2, h => by
      simp only [repSecs, repSizes, List.getD_cons_succ, List.length_cons] at h ⊢
      exact repEdges_ok m i (by omega)

theorem family_wf (m : Nat) : WF (repT m) := by
  refine ⟨?_, ?_, ?_, repEdges_ok m, ?_⟩
  · simp [repT, repSizes_length, repSecs_length]
  · cases m <;> rfl
  · cases m with
    | zero => rfl
    | succ m => simp only [repT, repSizes, List.getLast?_cons_cons]; exact repSizes_last m 2
  · intro i _
    rcases repSecs_sec m i with h | h | h <;> simp only [repT, h] <;> decide

/-- The trellis `repT m` represents `{00,11}^m`. -/
theorem family_represents : ∀ m, Represents (repT m) (2*m) (repGens m)
  | 0 => by
      intro w
      cases w <;> simp [repT, repSecs, IsPath, span, repGens, zeroW]
  | m+1 => by
      intro w
      have ih := family_represents m
      simp only [Represents, RepresentsL, repT] at ih ⊢
      rw [mem_span_rep]
      match w with
      | [] => simp [repSecs, IsPath, pre]
      | [b] => simp [repSecs, IsPath, pre]
      | b :: c :: w' =>
          cases b <;> cases c <;> simp [repSecs, IsPath, pre, secA, secB, ih]

theorem maxL_cons (a : Nat) (l : List Nat) : maxL (a :: l) = max a (maxL l) := rfl
theorem sumL_cons (a : Nat) (l : List Nat) : sumL (a :: l) = a + sumL l := rfl

theorem family_numbers : ∀ m, maxStates (repT m) ≤ 2 ∧ maxEdges (repT m) ≤ 2 ∧
    numVertices (repT m) = 3*m + 1 ∧ numEdges (repT m) = 4*m
  | 0 => by decide
  | m+1 => by
      have ih := family_numbers m
      simp only [maxStates, maxEdges, numVertices, numEdges, repT, repSizes, repSecs,
        List.map_cons, maxL_cons, sumL_cons] at ih ⊢
      simp only [secA, secB, List.length_cons, List.length_nil]
      omega

theorem family_viterbi (m : Nat) : viterbiOps (repT m) = 5*m := by
  have := family_numbers m
  simp only [viterbiOps]; omega

theorem family_bound (m : Nat) : bound (2*m) m 1 = m := by simp only [bound]; omega

theorem four_le_pow (m : Nat) (hm : 2 ≤ m) : 4 ≤ 2^m := by
  have := Nat.pow_le_pow_right (n := 2) (by decide) hm; simpa using this

theorem five_mul_lt_pow : ∀ j, 5 * (j+5) < 2^(j+5)
  | 0 => by decide
  | j+1 => by
      have := five_mul_lt_pow j
      rw [show j + 1 + 5 = (j+5) + 1 by omega, Nat.pow_succ]; omega

/-- **The family.** For every `m ≥ 2`, the `[2m, m]` code `{00,11}^m` has a trellis with at most
2 states and 2 edges per section, while the claimed bound is `m` bits (`2^m ≥ 4` states). -/
theorem family_gap_states (m : Nat) (hm : 2 ≤ m) :
    maxStates (repT m) < 2 ^ bound (2*m) m 1 ∧ maxEdges (repT m) < 2 ^ bound (2*m) m 1 := by
  have := family_numbers m; have := four_le_pow m hm
  rw [family_bound]; omega

/-- For every `m ≥ 5`, all five measures of `repT m` lie below `2^m`. -/
theorem family_gap_all (μ : Measure) (m : Nat) (hm : 5 ≤ m) :
    μ.eval (repT m) < 2 ^ bound (2*m) m 1 := by
  have h := family_numbers m
  have hv := family_viterbi m
  have hp := five_mul_lt_pow (m - 5)
  rw [show m - 5 + 5 = m by omega] at hp
  rw [family_bound]
  cases μ <;> simp only [Measure.eval] <;> omega

/-- Each member of the family (`m ≥ 2`) refutes the clause for state and edge complexity. -/
theorem clause_false_family (m : Nat) (hm : 2 ≤ m) :
    ¬ (∀ T : Trellis, WF T → Represents T (2*m) (repGens m) →
        2 ^ bound (2*m) m 1 ≤ maxStates T) ∧
    ¬ (∀ T : Trellis, WF T → Represents T (2*m) (repGens m) →
        2 ^ bound (2*m) m 1 ≤ maxEdges T) := by
  have h := family_gap_states m hm
  exact ⟨fun H => absurd (H _ (family_wf m) (family_represents m)) (Nat.not_le.2 h.1),
         fun H => absurd (H _ (family_wf m) (family_represents m)) (Nat.not_le.2 h.2)⟩

/-- Each member of the family with `m ≥ 5` refutes the clause for every measure. -/
theorem clause_false_family_all (μ : Measure) (m : Nat) (hm : 5 ≤ m) :
    ¬ (∀ T : Trellis, WF T → Represents T (2*m) (repGens m) →
        2 ^ bound (2*m) m 1 ≤ μ.eval T) := fun H =>
  absurd (H _ (family_wf m) (family_represents m)) (Nat.not_le.2 (family_gap_all μ m hm))


/-- The minimal (BCJR) trellis of `{00,11}^m` has `max_i |V_i| = 2` (so `s_max = 1`), checked for
`m = 1, …, 6`; the general statement is proved in the report. -/
theorem family_minProfile_small : ∀ m, m < 7 → 1 ≤ m →
    maxL (minProfile (2*m) (span (2*m) (repGens m))) = 2 := by decide +kernel

/-! ## The worst coordinate order -/

/-- All lists of length `n` with entries `< b`. -/
def allLists : Nat → Nat → List (List Nat)
  | 0, _ => [[]]
  | n+1, b => (List.range b).flatMap fun i => (allLists n b).map (i :: ·)

theorem mem_allLists (b : Nat) : ∀ (n : Nat) (π : List Nat), π.length = n → (∀ i ∈ π, i < b) →
    π ∈ allLists n b
  | 0, [], _, _ => by simp [allLists]
  | n+1, i :: π, hl, hb => by
      simp only [allLists, List.mem_flatMap, List.mem_range, List.mem_map]
      exact ⟨i, hb i (List.mem_cons_self ..), π,
        mem_allLists b n π (by simpa using hl) (fun j hj => hb j (List.mem_cons_of_mem _ hj)), rfl⟩

/-- The `[4,2]` code generated by `1000, 0111` (no zero coordinate). -/
def gensW : List Word := [[true, false, false, false], [false, true, true, true]]

theorem worst4_all_orders : ∀ π ∈ allLists 4 4, IsPermOf 4 π →
    maxL (minProfile 4 ((span 4 gensW).map (permW π))) ≤ 2 := by decide +kernel

/-- Even the **worst** coordinate order does not reach the bound: for the `[4,2]` code generated
by `1000, 0111`, every order gives a minimal trellis with at most 2 states, while the bound asks
for `2^{min(2,2)} = 4`. (No coordinate order can make both the past and the future injective,
since only the first coordinate sees the first generator.) -/
theorem worstOrder_false : ¬ ClauseMinWorst := fun h => by
  obtain ⟨π, hπ, hle⟩ := h 4 2 gensW 1 (by decide) ceilLog2_two
  have := worst4_all_orders π (mem_allLists 4 4 π hπ.1 hπ.2.2) hπ
  have hb : bound 4 2 1 = 2 := by decide
  rw [hb] at hle
  simp at hle; omega

/-! ## Non-vacuity -/

/-- The interleaved `[4,2]` code `{0000, 1010, 0101, 1111}` (the same code as `gens4` up to a
coordinate permutation) has minimal profile `1,2,4,2,1`: it *attains* the bound `2^2`.
So the minimal-trellis measure is not trivially small, and the coordinate order matters. -/
def gensI : List Word := [[true, false, true, false], [false, true, false, true]]

theorem inter4_meets_bound :
    IsGen 4 2 gensI ∧ minProfile 4 (span 4 gensI) = [1, 2, 4, 2, 1] ∧
    2 ^ bound 4 2 1 ≤ maxL (minProfile 4 (span 4 gensI)) := by decide

theorem span_rep2 : span 2 [[true, true]] = [[false, false], [true, true]] := by decide

/-- For the repetition code `{00, 11}` the bound holds for **every** trellis: any trellis for it
has at least `2 = 2^{min(1,1)}` states. So the clause quantifies over a nonempty, nontrivial
class and can be true for particular codes. -/
theorem rep2_clause_holds (T : Trellis) (hT : WF T) (hR : Represents T 2 [[true, true]]) :
    2 ^ bound 2 1 1 ≤ maxStates T := by
  have h00 := (hR [false, false]).2 (by rw [span_rep2]; decide)
  have h11 := (hR [true, true]).2 (by rw [span_rep2]; decide)
  have h01 : ¬ IsPath T.secs 0 [false, true] := fun h => by
    have := (hR _).1 h; rw [span_rep2] at this; revert this; decide
  obtain ⟨sizes, secs⟩ := T
  simp only at h00 h11 h01
  match secs, h00, h11, h01, hT with
  | [s1, s2], ⟨t0, e0, u0, f0, hu0⟩, ⟨t1, e1, u1, f1, hu1⟩, h01, hT =>
    simp only [IsPath] at hu0 hu1 h01
    subst hu0; subst hu1
    have ht : t0 ≠ t1 := by
      intro h; subst h; exact h01 ⟨t0, e0, 0, f1, rfl⟩
    have b0 := (hT.2.2.2.1 0 (by simp) _ e0).2
    have b1 := (hT.2.2.2.1 0 (by simp) _ e1).2
    simp only [List.getD_cons_zero, Nat.zero_add] at b0 b1
    have := le_maxL_getD sizes 1
    simp only [maxStates, bound]
    show 2 ≤ maxL sizes
    omega

/-- The clause's hypotheses are satisfiable (non-vacuity), e.g. by `C`, `T10`. -/
example : ∃ n k gens e T, IsGen n k gens ∧ CeilLog2 2 e ∧ WF T ∧ Represents T n gens :=
  ⟨10, 5, gens10, 1, T10, ex10_isGen, ceilLog2_two, ex10_wf, ex10_represents⟩

